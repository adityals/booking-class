{
  "name": "booking-class",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"next dev\" \"pnpm payment:dev\"",
    "payment:dev": "tsx --env-file-if-exists=.env services/payment-mock/server.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/migrate.ts --reset && pnpm db:seed",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "race:demo": "tsx --env-file-if-exists=.env scripts/race-demo.ts",
    "test": "tsx --env-file-if-exists=.env --test tests/**/*.test.ts"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "next": "16.3.4",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.5.1"
}
